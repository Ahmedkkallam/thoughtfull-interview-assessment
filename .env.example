# Local development values only (fictional credentials).
DATABASE_URL=postgres://thoughtfull:thoughtfull@localhost:54320/thoughtfull
TEST_DATABASE_URL=postgres://thoughtfull:thoughtfull@localhost:54329/thoughtfull_test
# Not PORT: many tools export PORT for their own server and it would hijack the API.
API_PORT=3000
# Shared password for the seeded demo accounts (fictional).
SEED_PASSWORD=demo-password-123
# Reminder emails go to a local Mailpit only (docker compose up -d mailpit); see http://localhost:8025.
# Leave unset and emails stay queued in the database. MAIL_FROM is optional.
SMTP_URL=smtp://localhost:1025
# MAIL_FROM=ThoughtFull <reminders@thoughtfull.local>
# Where the links in reminder emails point (the web app). Default: http://localhost:5173
APP_URL=http://localhost:5173
